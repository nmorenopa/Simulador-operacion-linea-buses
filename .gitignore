# Entorno virtual (cada quien crea el suyo con: py -3.14 -m venv .venv)
.venv/

# Configuración personal del editor (decisión 7 del plan)
.vscode/

# Archivos del sistema operativo (macOS y Windows)
.DS_Store
Thumbs.db
